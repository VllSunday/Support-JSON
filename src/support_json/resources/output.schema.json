{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Support-JSON output v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "priority", "sentiment", "action", "recommended_action", "reply", "missing_info", "supported_rule_ids", "human_escalation"],
  "properties": {
    "category": {"type": "string", "enum": ["billing", "access", "technical", "refund", "cancellation", "integration", "product", "other"]},
    "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "sentiment": {"type": "string", "enum": ["positive", "neutral", "negative"]},
    "action": {"type": "string", "enum": ["answer", "ask_details", "propose_action", "escalate"]},
    "recommended_action": {"type": "string", "enum": ["explain_policy", "request_details", "propose_refund", "propose_cancellation", "propose_password_reset", "propose_diagnostics", "propose_invoice_download", "propose_plan_change", "propose_integration_check", "human_review"]},
    "reply": {"type": "string", "minLength": 1},
    "missing_info": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "supported_rule_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "human_escalation": {"type": "boolean"}
  }
}
